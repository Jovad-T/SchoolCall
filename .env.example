# VITE_GEMINI_API_KEY: Required for client-side Gemini AI calls in frontend/Vercel
VITE_GEMINI_API_KEY=

# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# VITE_SERVER_URL: The URL of the backend Socket.io server (if any).
VITE_SERVER_URL=
