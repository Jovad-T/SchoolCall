{
  "name": "school-call",
  "private": true,
  "version": "1.0.0",
  "main": "class.cjs",
  "type": "module",
  "build": {
    "appId": "com.schoolcall.app",
    "productName": "SchoolCallApp",
    "artifactName": "SchoolCallApp_Setup_ver.1.${ext}",
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "dist/**/*",
      "preload.js",
      "public/**/*",
      "class.cjs",
      "main.cjs",
      ".env"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SchoolCallApp"
    }
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "electron class.cjs",
    "build:win": "vite build && electron-packager . SchoolCallApp --platform=win32 --arch=x64 --out=dist_electron --overwrite",
    "build:installer": "npm run build:class",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:office": "vite build && electron-builder --win nsis -c.extraMetadata.main=\"main.cjs\" -c.productName=\"학생 호출 도우미\" -c.nsis.shortcutName=\"학생 호출 도우미\" -c.directories.output=\"dist_office\"",
    "build:class": "vite build && electron-builder --win nsis -c.extraMetadata.main=\"class.cjs\" -c.productName=\"SchoolCallApp\" -c.nsis.shortcutName=\"SchoolCallApp\" -c.directories.output=\"dist_class\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pdf-parse": "1.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}